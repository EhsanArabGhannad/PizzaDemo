@model AdminLoginViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin sign in";
}

<div class="login-shell">
    <section class="login-card" aria-labelledby="login-title">
        <a class="login-brand" asp-controller="Home" asp-action="Index">
            <img src="~/assets/images/pizza-knight-logo.png" alt="" width="88" height="88" />
            <span>Pizza Knight</span>
        </a>
        <p class="admin-eyebrow">Staff area</p>
        <h1 id="login-title">Order management</h1>
        <p class="login-intro">Sign in to review incoming test orders and update their kitchen status.</p>

        <form asp-action="Login" method="post" class="admin-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>

            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>

            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>

            <label class="remember-field">
                <input asp-for="RememberMe" />
                <span>Keep me signed in on this device</span>
            </label>

            <button class="admin-button admin-button--primary" type="submit">Sign in</button>
        </form>

        <small class="login-note">Development admin only. Live credentials must be supplied securely before launch.</small>
    </section>
</div>
